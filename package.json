{
  "name": "@tonyzdev/dsh-session-messaging",
  "description": "Lets one top-level DSH session message another or open a new one: session_list finds sessions, session_send_message delivers an attributed message that wakes or resumes the target, session_create opens a titled session that starts with a message, and recipients can reply the same way. Carries an appending task ledger so one task has one writer, each wake-up knows what is already done, and every round ends with a receipt",
  "version": "0.6.0",
  "author": "tonyzdev",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/tasks.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session-messaging",
    "cross-session",
    "multi-agent",
    "agent-collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyzdev/dsh-session-messaging.git"
  },
  "homepage": "https://github.com/tonyzdev/dsh-session-messaging#readme",
  "bugs": {
    "url": "https://github.com/tonyzdev/dsh-session-messaging/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
